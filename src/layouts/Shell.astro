---
import "../styles/global.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · JAGD</title>
  </head>
  <body>
    <header class="wrap">
      <nav style="display: inline-flex; gap: 16px;">
        <a href="/">JAGD</a>
        <a href="/#projects">Projects</a>
        <a href="/johnny">Johnny</a>
        <a href="/andrew">Andrew</a>
        <a href="/giuseppi">Giuseppi</a>
      </nav>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="wrap">JAGD · placeholder footer</footer>
  </body>
</html>
