---
/*
  The hero stage: one small window per person. A decorative mirror of the
  names in the hero sentence (Hero.astro drives it), so it's hidden from
  assistive tech and out of the tab order.
*/
import Win from "./Win.astro";
import { people } from "./data";
---

<div class="stage" id="stage" aria-hidden="true">
  {
    people.map((p) => (
      <Win
        as="a"
        class="pwin"
        variant="mini"
        href={p.href}
        data-person={p.id}
        tabindex="-1"
        title={`${p.id}.jpg`}
        glyphSrc={p.photo}
        glyphSize={15}
      >
        <img class="pwin-photo" src={p.photo} alt="" width={p.photoSize} height={p.photoSize} />
        <span class="pwin-cap">
          <span class="pwin-name">{p.first}</span>
          <span class="pwin-role">{p.role}</span>
        </span>
      </Win>
    ))
  }
  <span class="stage-hint comment"><span class="line mouse">hover our names</span><span class="line touch">tap a name to meet us</span></span>
</div>

<style>
  .stage { position: relative; height: 396px; --pw: 204px; }
  /* .stage prefix: outranks the window chrome's own `.win { position: relative }`. */
  .stage .pwin {
    position: absolute; left: 50%; top: 52px;
    width: var(--pw); margin-left: calc(var(--pw) / -2);
    display: block; color: var(--ink); text-decoration: none;
    transform: translate(var(--x), var(--y)) scale(var(--s, 1));
    transition: transform .45s var(--ease-out), box-shadow .3s, filter .3s;
    will-change: transform;
  }
  .pwin-photo { width: 100%; aspect-ratio: 1; object-fit: cover; object-position: 50% 30%; background: #e4e7ec; }
  .pwin-cap { display: flex; flex-direction: column; gap: 3px; padding: 10px 12px 12px; border-top: 1px solid var(--rule); }
  .pwin-name { font: 600 17px/1.1 var(--sans); letter-spacing: -0.01em; }
  .pwin-role { font: 400 11.5px/1.3 var(--mono); color: var(--ink-3); }
  .pwin:hover { color: var(--ink); }

  .pwin[data-person="johnny"]   { --x: -86px; --y: 40px;  z-index: 1; }
  .pwin[data-person="andrew"]   { --x: 2px;   --y: -10px; z-index: 3; }
  .pwin[data-person="giuseppi"] { --x: 88px;  --y: 58px;  z-index: 2; }

  .stage.has-active .pwin { --s: 0.93; filter: saturate(0.5) brightness(0.97); }
  .stage.has-active .pwin[data-person="johnny"]   { --x: 8px;  --y: 30px; }
  .stage.has-active .pwin[data-person="andrew"]   { --x: 52px; --y: 12px; }
  .stage.has-active .pwin[data-person="giuseppi"] { --x: 94px; --y: 44px; }
  .stage.has-active .pwin.is-active {
    --x: -50px; --y: -14px; --s: 1.06;
    z-index: 10; filter: none; box-shadow: var(--shadow-lift);
  }
  .stage-hint { position: absolute; left: 0; top: 0; transition: opacity .25s; }
  .stage-hint .touch { display: none; }
  .stage.has-active .stage-hint { opacity: 0; }

  @media (max-width: 1080px) {
    .stage { --pw: 180px; height: 372px; }
  }
  @media (max-width: 760px) {
    .stage { grid-area: stage; height: 236px; margin-top: 18px; margin-bottom: 40px; --pw: 116px; }
    .stage .pwin { top: 22px; }
    .pwin-cap { padding: 7px 8px 8px; }
    .pwin-name { font-size: 15px; }
    .pwin-role { display: none; }
    .pwin[data-person="johnny"]   { --x: -110px; --y: 14px; }
    .pwin[data-person="andrew"]   { --x: 0px;    --y: 0px; }
    .pwin[data-person="giuseppi"] { --x: 110px;  --y: 20px; }
    .stage.has-active .pwin { --s: 0.94; }
    .stage.has-active .pwin[data-person="johnny"]   { --x: -114px; --y: 20px; }
    .stage.has-active .pwin[data-person="andrew"]   { --x: 0px;    --y: 8px; }
    .stage.has-active .pwin[data-person="giuseppi"] { --x: 114px;  --y: 26px; }
    .stage.has-active .pwin.is-active { --y: -6px; --s: 1.12; }
    .stage.has-active .pwin.is-active[data-person="johnny"] { --x: -86px; }
    .stage.has-active .pwin.is-active[data-person="andrew"] { --x: 0px; }
    .stage.has-active .pwin.is-active[data-person="giuseppi"] { --x: 86px; }
    .stage-hint { left: 0; right: 0; top: auto; bottom: -6px; text-align: center; }
  }
  @media (max-width: 380px) {
    .stage { --pw: 106px; }
    .pwin[data-person="johnny"]   { --x: -100px; }
    .pwin[data-person="giuseppi"] { --x: 100px; }
    .stage.has-active .pwin[data-person="johnny"]   { --x: -104px; }
    .stage.has-active .pwin[data-person="giuseppi"] { --x: 104px; }
  }
  @media (hover: none), (pointer: coarse) {
    .stage-hint .mouse { display: none; }
    .stage-hint .touch { display: inline; }
  }
</style>
