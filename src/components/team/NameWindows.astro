---
/*
  The hero stage: one small window per person, side by side. A decorative
  mirror of the names in the hero sentence (Hero.astro drives it), so it's
  hidden from assistive tech and out of the tab order.
*/
import Win from "./Win.astro";
import { people } from "./data";
---

<div class="stage" id="stage" aria-hidden="true">
  <span class="stage-hint comment"><span class="line mouse">hover our names</span><span class="line touch">tap a name to meet us</span></span>
  <div class="stage-row">
    {
      people.map((p) => (
        <Win
          as="a"
          class="pwin"
          variant="mini"
          href={p.href}
          data-person={p.id}
          tabindex="-1"
          title={`${p.id}.jpg`}
          glyphSrc={p.photo}
          glyphSize={15}
        >
          <img class="pwin-photo" src={p.photo} alt="" width={p.photoSize} height={p.photoSize} />
          <span class="pwin-cap">
            <span class="pwin-name">{p.first}</span>
            <span class="pwin-role">{p.role}</span>
          </span>
        </Win>
      ))
    }
  </div>
</div>

<style>
  .stage { display: grid; gap: 10px; }
  .stage-hint { display: block; }
  .stage-hint .touch { display: none; }
  .stage-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .stage .pwin {
    display: block; min-width: 0; color: var(--ink); text-decoration: none;
    transition: transform .3s var(--ease-out), box-shadow .3s var(--ease-out);
  }
  .pwin-photo { width: 100%; aspect-ratio: 1; object-fit: cover; object-position: 50% 30%; background: #e4e7ec; }
  .pwin-cap { display: flex; flex-direction: column; gap: 3px; padding: 10px 12px 12px; border-top: 1px solid var(--rule); }
  .pwin-name { font: 600 17px/1.1 var(--sans); letter-spacing: -0.01em; }
  .pwin-role { font: 400 11.5px/1.3 var(--mono); color: var(--ink-3); }
  .pwin:hover { color: var(--ink); }
  /* Hovered card, or its name hovered/focused in the headline: lift only. */
  .stage .pwin:hover, .stage .pwin.is-active { transform: translateY(-4px); box-shadow: var(--shadow-lift); }

  @media (max-width: 760px) {
    .stage { grid-area: stage; margin-top: 18px; margin-bottom: 24px; }
    .stage-row { gap: 8px; }
    .pwin-cap { padding: 7px 8px 8px; }
    .pwin-name { font-size: 15px; }
    .pwin-role { display: none; }
  }
  @media (hover: none), (pointer: coarse) {
    .stage-hint .mouse { display: none; }
    .stage-hint .touch { display: inline; }
  }
</style>
