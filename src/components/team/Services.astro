---
/* Services: what we make, as file-type rows. Each button pre-selects the matching need in the contact form (see Contact.astro). */
import SectionMeta from "./SectionMeta.astro";
import { services } from "./data";
---

<section class="section" id="services" aria-labelledby="services-title">
  <div class="wrap row">
    <SectionMeta label="Services" path="~/jag/services/" when="what we make" />
    <div class="body">
      <h2 id="services-title">What we can make for you</h2>
      <p class="intro">Pick the one that sounds like you. If none do, write anyway.</p>
    </div>
    <div class="services-wrap">
      <ul class="services">
        {
          services.map((s) => (
            <li class="service">
              <span class="ficon" aria-hidden="true">
                {s.icon === "website" && (
                  <svg viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4" width="21" height="18" rx="2.5" /><path d="M2.5 9h21" /><path d="M5.5 6.5h.01M8 6.5h.01" /><path d="M6.5 13h8M6.5 16.5h13" /></svg>
                )}
                {s.icon === "app" && (
                  <svg viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="2.5" width="12" height="21" rx="2.8" /><path d="M11.5 5.5h3M11.5 20h3" /></svg>
                )}
                {s.icon === "both" && (
                  <svg viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 18.5H4a1.5 1.5 0 0 1-1.5-1.5V5.5A1.5 1.5 0 0 1 4 4h15a1.5 1.5 0 0 1 1.5 1.5V9" /><path d="M2.5 8h18" /><rect x="16" y="11" width="7.5" height="12.5" rx="1.8" /><path d="M18.8 21h2" /></svg>
                )}
                {s.icon === "fix" && (
                  <svg viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M16.2 4.1a5.5 5.5 0 0 0-6.8 7.1l-6 6a2 2 0 0 0 2.8 2.8l6-6a5.5 5.5 0 0 0 7.1-6.8l-3.3 3.3-2.6-.5-.5-2.6 3.3-3.3z" /></svg>
                )}
              </span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <a class="btn btn-ghost btn-sm" href="#contact" data-need={s.need} data-msg={s.msg}>{s.cta} <span class="arrow" aria-hidden="true">→</span></a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .services-wrap { grid-column: 2 / 4; }
  .services {
    list-style: none; margin: 34px 0 0; padding: 0;
    background: var(--surface); border: 1px solid var(--rule); border-radius: 12px;
    box-shadow: 0 1px 2px rgba(20, 24, 33, 0.05);
  }
  .service { display: grid; grid-template-columns: 46px 190px minmax(0, 1fr) auto; gap: 22px; align-items: center; padding: 20px 22px; }
  .service + .service { border-top: 1px solid var(--rule); }
  .service > * { min-width: 0; }
  .ficon {
    width: 46px; height: 46px; border-radius: 11px; display: grid; place-items: center;
    background: var(--accent-wash); color: var(--accent);
    box-shadow: inset 0 0 0 1px rgba(31, 85, 224, 0.14);
  }
  .ficon svg { width: 26px; height: 26px; }
  .service h3 { font-size: 22px; line-height: 1.15; letter-spacing: -0.02em; }
  .service p { color: var(--ink-2); font-size: 16px; line-height: 1.5; }
  .service .btn { justify-self: end; min-width: 164px; }

  @media (max-width: 1180px) {
    .service { grid-template-columns: 46px 160px minmax(0, 1fr) auto; gap: 18px; }
  }
  @media (max-width: 1080px) {
    .services-wrap { grid-column: 2; }
    .service { grid-template-columns: 46px minmax(0, 1fr) auto; }
    .service p { grid-column: 2 / 3; grid-row: 2; }
    .service .btn { grid-row: 1 / 3; grid-column: 3; }
    .service .ficon { grid-row: 1 / 3; }
    .service { row-gap: 4px; }
  }
  @media (max-width: 760px) {
    .services-wrap { grid-column: 1; }
    .service, .service:nth-child(n) { grid-template-columns: 42px minmax(0, 1fr); gap: 6px 14px; padding: 18px 16px; align-items: center; }
    .service .ficon { grid-row: auto; width: 42px; height: 42px; border-radius: 10px; }
    .service .ficon svg { width: 24px; height: 24px; }
    .service h3 { font-size: 20px; }
    .service p { grid-column: 1 / -1; grid-row: auto; margin-top: 4px; font-size: 15.5px; }
    .service .btn { grid-column: 1 / -1; grid-row: auto; justify-self: stretch; margin-top: 8px; }
  }
</style>
