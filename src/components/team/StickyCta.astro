---
/* Sticky "Start a project" button on phones: shows after the hero, hides at the contact section and footer. */
---

<a class="btn btn-primary sticky-cta" id="sticky-cta" href="#contact" tabindex="-1" aria-hidden="true">Start a project <span class="arrow" aria-hidden="true">→</span></a>

<script>
  const sticky = document.getElementById("sticky-cta");
  const heroCta = document.querySelector(".hero-cta");
  const contact = document.getElementById("contact");
  const footer = document.getElementById("footer");
  if (sticky && heroCta && contact && footer && "IntersectionObserver" in window) {
    let heroGone = false;
    let contactSeen = false;
    let footerSeen = false;
    const update = () => {
      const show = heroGone && !contactSeen && !footerSeen;
      sticky.classList.toggle("is-visible", show);
      sticky.setAttribute("aria-hidden", show ? "false" : "true");
      sticky.tabIndex = show ? 0 : -1;
    };
    new IntersectionObserver((en) => { heroGone = !en[0].isIntersecting; update(); }).observe(heroCta);
    new IntersectionObserver((en) => { contactSeen = en[0].isIntersecting; update(); }).observe(contact);
    new IntersectionObserver((en) => { footerSeen = en[0].isIntersecting; update(); }).observe(footer);
  }
</script>

<style>
  .sticky-cta { display: none; }

  @media (max-width: 760px) {
    .sticky-cta {
      display: flex; position: fixed; left: 16px; right: 16px; bottom: 14px; z-index: 60;
      min-height: 50px; box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 10px 30px -10px rgba(15, 40, 120, .6);
      transform: translateY(140%); opacity: 0;
      transition: transform .35s var(--ease-out), opacity .25s;
      pointer-events: none;
    }
    .sticky-cta.is-visible { transform: none; opacity: 1; pointer-events: auto; }
  }
</style>
