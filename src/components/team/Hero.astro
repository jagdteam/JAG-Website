---
/*
  Hero: what we do, in one sentence with our three names. Hovering, focusing
  or tapping a name pops that person's window out of the stage beside it.
*/
import NameWindows from "./NameWindows.astro";
import Todo from "./Todo.astro";
import Proof from "./Proof.astro";
import { people } from "./data";

const [johnny, andrew, giuseppi] = people;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid" id="hero-grid">
    <p class="kicker"><span class="led" aria-hidden="true"></span><span>A three-person <span class="hide-sm">software </span>studio · Irvine, <span class="hide-sm">California</span><span class="show-sm">CA</span></span></p>
    <h1 id="hero-title">
      {/* Kept on one line: Astro drops line-break whitespace before inline elements. */}
      Hi, we're <a class="name-link" href={johnny.href} data-person={johnny.id}>{johnny.first}</a>, <a class="name-link" href={andrew.href} data-person={andrew.id}>{andrew.first}</a> and <a class="name-link" href={giuseppi.href} data-person={giuseppi.id}>{giuseppi.first}</a>. We build websites and apps for companies, and we answer our own emails.<span class="caret" aria-hidden="true"></span>
    </h1>

    <div class="hero-side">
      <NameWindows />
      <Todo />
    </div>

    <p class="hero-sub">Marketing sites, web apps, and iOS and Android apps. You work directly with the three engineers who design, build and ship it.</p>

    <div class="hero-cta">
      <a class="btn btn-primary" href="#contact">Start a project <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn-ghost" href="#work">See our work</a>
      <p class="cta-note comment"><span class="line">the first call is free,</span><span class="line">and it's just us</span></p>
    </div>

    <Proof />
  </div>
</section>

<script>
  /* Hero: names pop out their window */
  const stage = document.getElementById("stage");
  const heroGrid = document.getElementById("hero-grid");
  if (stage && heroGrid) {
    const names = Array.from(document.querySelectorAll<HTMLAnchorElement>(".name-link"));
    const wins = Array.from(stage.querySelectorAll<HTMLElement>(".pwin"));
    let active: string | null = null;
    let lastPointer = "mouse";

    const setActive = (person: string | null) => {
      active = person;
      stage.classList.toggle("has-active", !!person);
      wins.forEach((w) => w.classList.toggle("is-active", w.dataset.person === person));
      names.forEach((n) => n.classList.toggle("is-active", n.dataset.person === person));
    };

    document.addEventListener("pointerdown", (e) => { lastPointer = e.pointerType || "mouse"; }, true);

    names.forEach((n) => {
      const person = n.dataset.person ?? null;
      n.addEventListener("mouseenter", () => { if (lastPointer === "mouse") setActive(person); });
      n.addEventListener("focus", () => setActive(person));
      n.addEventListener("blur", () => {
        setTimeout(() => {
          if (!names.some((x) => x === document.activeElement)) setActive(null);
        }, 0);
      });
      n.addEventListener("click", (e) => {
        // Touch: a tap pops the window instead of navigating. The window itself links to the page.
        if (lastPointer === "touch" || lastPointer === "pen") {
          e.preventDefault();
          setActive(active === person ? null : person);
        }
      });
    });
    wins.forEach((w) => {
      w.addEventListener("mouseenter", () => { if (lastPointer === "mouse") setActive(w.dataset.person ?? null); });
    });
    heroGrid.addEventListener("mouseleave", () => { if (lastPointer === "mouse") setActive(null); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && active) setActive(null); });
    document.addEventListener("click", (e) => {
      if (!active || lastPointer === "mouse") return;
      const target = e.target as Element;
      if (!target.closest(".name-link") && !target.closest(".stage")) setActive(null);
    });
  }
</script>

<style>
  .hero { padding-top: 76px; }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    grid-template-areas:
      "kicker side"
      "title  side"
      "sub    side"
      "cta    side"
      ".      side"
      "proof  proof";
    grid-template-rows: auto auto auto auto 1fr auto;
    column-gap: 72px;
  }
  .hero-side { grid-area: side; display: flex; flex-direction: column; }
  .hero-grid > :global(*) { min-width: 0; }
  .kicker {
    grid-area: kicker; display: flex; align-items: center; gap: 10px; margin-bottom: 28px;
    font: 500 13px/1.4 var(--mono); color: var(--ink-3);
  }
  .kicker .led { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 3px rgba(23, 128, 61, 0.15); flex: none; }
  .hero h1 {
    grid-area: title;
    font-size: clamp(2.6rem, 1.35rem + 3.3vw, 4.1rem);
    line-height: 1.06;
    letter-spacing: -0.038em;
    font-weight: 600;
    text-wrap: pretty;
  }
  .name-link {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
    text-decoration-color: rgba(31, 85, 224, 0.35);
    border-radius: 6px;
    padding: 0 0.04em;
    transition: background-color .15s, text-decoration-color .15s;
    cursor: pointer;
  }
  /* Hovering a name selects it, like highlighted text. */
  .name-link:hover, .name-link.is-active {
    color: var(--accent);
    background: rgba(31, 85, 224, 0.14);
    text-decoration-color: var(--accent);
  }
  .caret {
    display: inline-block; width: 0.07em; height: 0.86em; margin-left: 0.08em;
    vertical-align: -0.08em; background: var(--accent); border-radius: 1px;
    animation: blink 1.1s steps(1, end) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  .hero-sub { grid-area: sub; margin-top: 26px; font-size: 19px; line-height: 1.6; color: var(--ink-2); max-width: 36em; }
  .hero-cta { grid-area: cta; margin-top: 34px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .cta-note { margin-left: 10px; }

  @media (max-width: 1080px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr) 320px; column-gap: 40px; }
  }
  @media (max-width: 760px) {
    .hero { padding-top: 36px; }
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "kicker" "title" "stage" "sub" "cta" "proof" "todo";
      grid-template-rows: none;
    }
    .hero-side { display: contents; }
    .kicker { margin-bottom: 18px; font-size: 12px; }
    .hero h1 { font-size: 2.5rem; line-height: 1.08; letter-spacing: -0.035em; }
    .hero-sub { margin-top: 0; font-size: 17.5px; }
    .hero-cta { margin-top: 26px; flex-direction: column; align-items: stretch; gap: 12px; }
    .hero-cta .btn { width: 100%; }
    .cta-note { margin: 4px 0 0 2px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret { animation: none !important; opacity: 1; }
  }
</style>
