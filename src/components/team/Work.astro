---
/* Work: the projects we built together as JAG. */
import SectionMeta from "./SectionMeta.astro";
import WorkEntry from "./WorkEntry.astro";
import { projects } from "./data";
---

<section class="section" id="work" aria-labelledby="work-title">
  <div class="wrap row">
    <SectionMeta label="Work" path="~/jag/work/" when={`${projects.length} projects`} />
    <div class="body">
      <h2 id="work-title">Things we've made together</h2>
      <p class="intro">Two projects we built as JAG, one for a client and one of our own. We're also building a mobile app, website and admin dashboards for a private client in sports tech, which we can't show yet.</p>
    </div>
  </div>

  {projects.map((project) => <WorkEntry project={project} />)}
</section>
