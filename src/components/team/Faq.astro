---
/* FAQ: disclosure rows like a file list. Items flagged `draft` in data.ts aren't confirmed by the team yet. */
import SectionMeta from "./SectionMeta.astro";
import { faq } from "./data";
---

<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="wrap row">
    <SectionMeta label="FAQ" path="~/jagd/faq.md" when="fair questions" />
    <div class="body">
      <h2 id="faq-title">Questions people ask us</h2>
      <div class="faq">
        <p class="faq-head" aria-hidden="true"><span>question</span><span>tap to open</span></p>
        {
          faq.map((item) => (
            <details>
              <summary>
                <svg class="tri" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3.5l5 4.5-5 4.5z" fill="currentColor" /></svg>
                <span class="q">{item.q}{item.draft && <> <span class="draft">draft</span></>}</span>
              </summary>
              <p class="answer">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .faq {
    margin-top: 30px; background: var(--surface);
    border: 1px solid var(--rule); border-radius: 12px; overflow: hidden;
    box-shadow: 0 1px 2px rgba(20, 24, 33, 0.05);
  }
  .faq-head {
    display: flex; justify-content: space-between; padding: 9px 18px 9px 48px;
    background: var(--surface-2); border-bottom: 1px solid var(--rule);
    font: 500 12px/1.3 var(--mono); color: var(--ink-3);
  }
  .faq details + details { border-top: 1px solid var(--rule); }
  .faq summary {
    list-style: none; cursor: pointer; display: grid; grid-template-columns: 16px minmax(0, 1fr); align-items: start; gap: 14px;
    padding: 16px 18px; font-size: 17.5px; font-weight: 500; line-height: 1.4; letter-spacing: -0.01em;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary:hover { background: var(--accent-wash-2); }
  .faq summary:focus-visible { outline-offset: -2px; border-radius: 0; }
  .faq details[open] summary { background: var(--accent-wash); }
  .faq .q { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; min-width: 0; }
  .tri { width: 16px; height: 16px; margin-top: 3px; color: var(--ink-3); transition: transform .2s; }
  .faq details[open] .tri { transform: rotate(90deg); color: var(--accent); }
  .faq .answer { padding: 4px 26px 20px 48px; color: var(--ink-2); font-size: 16.5px; }
  .draft {
    display: inline-block; flex-shrink: 0;
    font: 500 11.5px/1 var(--mono); color: var(--ink-3);
    border: 1px dashed var(--rule-strong); border-radius: 5px; padding: 4px 6px;
  }

  @media (max-width: 760px) {
    .faq-head { padding-left: 44px; }
    .faq summary { padding: 15px 14px; font-size: 16.5px; }
    .faq .answer { padding: 2px 16px 18px 44px; font-size: 16px; }
  }
</style>
