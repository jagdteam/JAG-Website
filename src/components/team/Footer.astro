---
/* Footer: links, plus a slim status bar. */
import { contactEmail, socials } from "./data";

const links = [
  { href: "#work", label: "Work" },
  { href: "#services", label: "Services" },
  { href: "#team", label: "Team" },
  { href: "#contact", label: "Contact" },
];
---

<footer class="site-footer" id="footer">
  <div class="wrap footer-top">
    <div class="footer-brand">
      <img src="/assets/jagd-logo-96.png" alt="" width="40" height="40" loading="lazy" />
      <div><div class="name">JAGD</div><div class="tag">Websites and apps, from Irvine, California.</div></div>
    </div>
    <ul class="footer-links">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      <li class="sep" aria-hidden="true"></li>
      <li><a href={`mailto:${contactEmail}`}>{contactEmail}</a></li>
      {socials.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
    </ul>
  </div>
  <div class="statusbar">
    <div class="wrap statusbar-inner">
      <ul class="status-items">
        <li><strong>JAGD</strong></li>
        <li><span class="led" aria-hidden="true"></span>3 engineers online</li>
        <li class="hide-sm">Irvine, CA</li>
        <li>© 2026</li>
      </ul>
      <p class="comment"><span class="line">thanks for reading all the way down</span></p>
    </div>
  </div>
</footer>

<style>
  .site-footer { margin-top: 140px; }
  .footer-top { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px 40px; align-items: center; padding-bottom: 28px; }
  .footer-brand { display: flex; align-items: center; gap: 12px; }
  .footer-brand img { width: 40px; height: 40px; border-radius: 9px; }
  .footer-brand .name { font: 700 17px/1 var(--sans); letter-spacing: 0.08em; }
  .footer-brand .tag { margin-top: 5px; font-size: 14.5px; line-height: 1.3; color: var(--ink-3); }
  .footer-links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 22px; justify-content: flex-end; font-size: 15px; }
  .footer-links a { color: var(--ink-2); text-decoration: none; }
  .footer-links a:hover { color: var(--accent); text-decoration: underline; }
  .footer-links .sep { width: 1px; background: var(--rule-strong); align-self: stretch; }
  .statusbar { background: rgba(248, 249, 251, 0.92); border-top: 1px solid var(--rule); }
  .statusbar-inner {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 24px;
    min-height: 40px; padding-block: 9px;
    font: 400 12.5px/1.5 var(--mono); color: var(--ink-3);
  }
  .status-items { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 0; list-style: none; margin: 0; padding: 0; }
  .status-items li { display: inline-flex; align-items: center; gap: 7px; }
  .status-items li + li::before { content: "·"; margin: 0 10px; color: var(--rule-strong); }
  .status-items .led { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); }
  .status-items strong { color: var(--ink); font-weight: 600; }

  @media (max-width: 760px) {
    .status-items .hide-sm { display: none; }
    .site-footer { margin-top: 96px; }
    .footer-top { grid-template-columns: minmax(0, 1fr); }
    .footer-links { justify-content: flex-start; }
    .footer-links .sep { display: none; }
    .statusbar-inner { padding-bottom: 14px; }
    .status-items { gap: 2px 16px; }
    .status-items li + li::before { display: none; }
  }
</style>
