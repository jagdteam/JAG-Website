---
import { techIcons } from "./techIcons";
interface Props {
  label: string;
}
const { label } = Astro.props;
const icon = techIcons[label];
---

<span class:list={["chip", { ph: label.includes("[") }]}>
  {icon && <img src={`/assets/icons/${icon}`} alt="" width="14" height="14" />}{label}
</span>
