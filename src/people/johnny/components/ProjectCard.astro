---
import Chip from "./Chip.astro";
import Pill from "./Pill.astro";

interface Media {
  src: string;
  alt: string;
  kind: "image" | "gif" | "video";
  poster?: string;
}
interface Props {
  name: string;
  status: string;
  summary: string;
  team: string;
  tags: string[];
  image?: string;
  thumb?: string;
  thumbStill?: string;
  thumbFit?: "cover" | "contain";
  links?: { label: string; href?: string }[];
  myPart?: string;
  description?: string;
  media?: Media[];
  explore?: { href: string; label: string };
}
const {
  name,
  status,
  summary,
  team,
  tags,
  image,
  thumb,
  thumbStill,
  thumbFit,
  links = [],
  myPart,
  description,
  media = [],
  explore,
} = Astro.props;
const shown = links.filter(
  (l) =>
    l.href &&
    l.href !== "#" &&
    !(
      (l.label === "Website" || l.label === "Repo") &&
      explore &&
      l.href === explore.href
    ),
);
const extraDesc = description && description !== summary ? description : undefined;
const expandable = Boolean(extraDesc || media.length > 0 || explore);
const thumbAlt = thumbFit === "contain" ? `${name} logo` : `${name} screenshot`;
const external = explore ? /^https?:\/\//.test(explore.href) : false;
---

<div class="plate">
  <article class:list={["pl", "card", { thumbed: Boolean(thumb) }]}>
    <span class="trim" aria-hidden="true"></span>
    {image && <img class="shot" src={image} alt={name} />}
    {expandable ? (
      <>
      <details class="more" name="projects">
        <summary class="more-head">
          <div class="head-text">
          <div class="row1">
            <strong>{name}</strong>
            <Pill label={status} />
          </div>
          <p class:list={["one", { ph: summary.includes("[") }]}>{summary}</p>
          {myPart && <p class="mypart">my part · {myPart}</p>}
          <div class="row2">
            <span class:list={["team", { ph: team.includes("[") }]}>{team}</span>
            {tags.length > 0 && (
              <span class="chips">
                {tags.map((t) => (
                  <Chip label={t} />
                ))}
              </span>
            )}
          </div>
          <span class="open-tag" aria-hidden="true"><span class="tri"></span> <span class="open-word"></span></span>
          </div>
          {thumb && thumbStill && (
            <picture class="thumbpic">
              <source srcset={thumbStill} media="(prefers-reduced-motion: reduce)" />
              <img class:list={["thumb", { contain: thumbFit === "contain" }]} src={thumb} alt={thumbAlt} loading="lazy" />
            </picture>
          )}
          {thumb && !thumbStill && <img class:list={["thumb", { contain: thumbFit === "contain" }]} src={thumb} alt={thumbAlt} loading="lazy" />}
        </summary>
        <div class="panel">
          {extraDesc && <p class="desc">{extraDesc}</p>}
          {media.length > 0 && (
            <div class="gal">
              <div class="gal-view">
              <div class="gal-main">
                {media.map((m, i) =>
                  m.kind === "video" ? (
                    <video
                      src={m.src}
                      poster={m.poster}
                      loop
                      muted
                      playsinline
                      preload="none"
                      aria-label={m.alt}
                      hidden={i !== 0}
                    />
                  ) : (
                    <img
                      class:list={{ gif: m.kind === "gif" }}
                      src={m.src}
                      alt={m.alt}
                      loading="lazy"
                      hidden={i !== 0}
                    />
                  ),
                )}
              </div>
              </div>
              {media.length >= 1 && (
                <div class="gal-bar">
                  {media.length >= 2 && (
                    <button type="button" class="gal-arrow prev" aria-label="Previous">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" /></svg>
                  </button>
                  )}
                <div class="gal-strip">
                  {media.map((m, i) => (
                    <button type="button" aria-label={m.alt} aria-pressed={i === 0 ? "true" : "false"}>
                      {m.kind === "video" ? (
                        m.poster ? <img src={m.poster} alt="" loading="lazy" /> : <span class="clip">▶ clip</span>
                      ) : (
                        <img src={m.src} alt="" loading="lazy" />
                      )}
                    </button>
                  ))}
                </div>
                  {media.length >= 2 && (
                    <button type="button" class="gal-arrow next" aria-label="Next">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" /></svg>
                  </button>
                  )}
                </div>
              )}
            </div>
          )}
        </div>
      </details>
      {(explore || shown.length > 0) && (
        <div class="row2 linkrow">
          <span class="links">
            {explore && (
              <a href={explore.href} target="_blank" rel="noopener noreferrer">
                {explore.label} {external ? "↗" : "→"}
              </a>
            )}
            {shown.map((l, i) => (
              <>
                {(explore || i > 0) && " · "}
                {/^https?:\/\//.test(l.href) ? <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label} ↗</a> : <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>}
              </>
            ))}
          </span>
        </div>
      )}
      </>
    ) : (
      <div class="headrow">
        <div class="head-text">
        <div class="row1">
          <strong>{name}</strong>
          <Pill label={status} />
        </div>
        <p class:list={["one", { ph: summary.includes("[") }]}>{summary}</p>
        {myPart && <p class="mypart">my part · {myPart}</p>}
        <div class="row2">
          <span class:list={["team", { ph: team.includes("[") }]}>{team}</span>
          {tags.length > 0 && (
            <span class="chips">
              {tags.map((t) => (
                <Chip label={t} />
              ))}
            </span>
          )}
          {shown.length > 0 && (
            <span class="links">
              {shown.map((l, i) => (
                <>
                  {i > 0 && " · "}
                  {/^https?:\/\//.test(l.href) ? <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label} ↗</a> : <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>}
                </>
              ))}
            </span>
          )}
        </div>
        </div>
        {thumb && thumbStill && (
          <picture class="thumbpic">
            <source srcset={thumbStill} media="(prefers-reduced-motion: reduce)" />
            <img class:list={["thumb", { contain: thumbFit === "contain" }]} src={thumb} alt={thumbAlt} loading="lazy" />
          </picture>
        )}
        {thumb && !thumbStill && <img class:list={["thumb", { contain: thumbFit === "contain" }]} src={thumb} alt={thumbAlt} loading="lazy" />}
      </div>
    )}
  </article>
</div>

<script>
  // Animated open/close for project cards; also fade-in on scroll.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  const OPTS = { duration: 250, easing: "ease-out" } as const;

  function frames(panel: HTMLElement, open: boolean) {
    const cs = getComputedStyle(panel);
    const full = {
      height: cs.height,
      marginTop: cs.marginTop,
      paddingTop: cs.paddingTop,
      borderTopWidth: cs.borderTopWidth,
    };
    const zero = {
      height: "0px",
      marginTop: "0px",
      paddingTop: "0px",
      borderTopWidth: "0px",
    };
    return open ? [zero, full] : [full, zero];
  }

  function run(details: HTMLDetailsElement, open: boolean, done?: () => void) {
    const panel = details.querySelector<HTMLElement>(
      ":scope > .panel, :scope > ul",
    );
    if (!panel) {
      details.open = open;
      done?.();
      return;
    }
    const running = (details as any)._anim as Animation | undefined;
    if (running) running.finish();
    panel.style.overflow = "hidden";
    const anim = panel.animate(frames(panel, open), OPTS);
    (details as any)._anim = anim;
    anim.onfinish = anim.oncancel = () => {
      panel.style.overflow = "";
      (details as any)._anim = undefined;
      if (!open) details.open = false;
      done?.();
    };
  }

  // Gallery: videos play like a GIF (silent, looping) only while the card is open.
  const videosIn = (root: ParentNode) =>
    Array.from(root.querySelectorAll<HTMLVideoElement>(".gal-main video"));
  function playShown(details: HTMLDetailsElement) {
    if (reduce.matches) return;
    videosIn(details).forEach((v) => {
      if (v.hidden) return;
      v.muted = true;
      v.play()?.catch(() => {});
    });
  }
  if (reduce.matches) {
    videosIn(document).forEach((v) => v.setAttribute("controls", ""));
  }
  document.addEventListener(
    "toggle",
    (e) => {
      const d = e.target as HTMLElement;
      if (!(d instanceof HTMLDetailsElement) || !d.classList.contains("more")) return;
      if (d.open) playShown(d);
      else videosIn(d).forEach((v) => v.pause());
    },
    true,
  );

  function selectItem(gal: HTMLElement, idx: number) {
    const buttons = Array.from(gal.querySelectorAll<HTMLButtonElement>(".gal-strip button"));
    const items = Array.from(gal.querySelectorAll<HTMLElement>(".gal-main > *"));
    if (items.length === 0) return;
    const n = (idx + items.length) % items.length;
    items.forEach((it, i) => {
      it.hidden = i !== n;
      if (i !== n && it instanceof HTMLVideoElement) it.pause();
    });
    buttons.forEach((b, i) => b.setAttribute("aria-pressed", String(i === n)));
    const details = gal.closest("details") as HTMLDetailsElement | null;
    if (details?.open) playShown(details);
  }
  const currentIndex = (gal: HTMLElement) =>
    Array.from(gal.querySelectorAll<HTMLElement>(".gal-main > *")).findIndex((it) => !it.hidden);

  document.addEventListener("keydown", (e) => {
    if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
    if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
    const gal = (e.target as Element).closest?.<HTMLElement>(".gal");
    if (!gal || gal.querySelectorAll(".gal-main > *").length < 2) return;
    e.preventDefault();
    selectItem(gal, currentIndex(gal) + (e.key === "ArrowRight" ? 1 : -1));
  });

  document.addEventListener("click", (e) => {
    const target = e.target as Element;
    const thumbBtn = target.closest?.<HTMLButtonElement>(".gal-strip button");
    if (thumbBtn) {
      const gal = thumbBtn.closest(".gal") as HTMLElement;
      const buttons = Array.from(gal.querySelectorAll<HTMLButtonElement>(".gal-strip button"));
      selectItem(gal, buttons.indexOf(thumbBtn));
      return;
    }
    const arrow = target.closest?.<HTMLButtonElement>(".gal-arrow");
    if (arrow) {
      const gal = arrow.closest(".gal") as HTMLElement;
      selectItem(gal, currentIndex(gal) + (arrow.classList.contains("next") ? 1 : -1));
      return;
    }
    if (reduce.matches) return;
    const summary = (e.target as Element).closest?.(
      'details[name="projects"] > summary',
    );
    if (!summary) return;
    if ((e.target as Element).closest("a")) return;
    const details = summary.parentElement as HTMLDetailsElement;
    e.preventDefault();
    if (details.open) {
      run(details, false);
      return;
    }
    // Close any other open card with animation. Drop the shared name so the
    // browser does not snap it shut when this one opens.
    document
      .querySelectorAll<HTMLDetailsElement>('details[name="projects"][open]')
      .forEach((other) => {
        if (other === details) return;
        other.removeAttribute("name");
        run(other, false, () => other.setAttribute("name", "projects"));
      });
    details.open = true;
    run(details, true);
  });

  // Experience cards: click anywhere on a card with details toggles all of
  // its details together; a summary click toggles just that one.
  document.addEventListener("click", (e) => {
    const t = e.target as Element;
    if (!t.closest) return;
    if (t.closest("a")) return;
    const sum = t.closest<HTMLElement>(".exprow details > summary");
    if (sum) {
      if (reduce.matches) return;
      const d = sum.parentElement as HTMLDetailsElement;
      e.preventDefault();
      if (d.open) run(d, false);
      else {
        d.open = true;
        run(d, true);
      }
      return;
    }
    const plate = t.closest(".plate");
    if (!plate || !plate.querySelector(".exprow")) return;
    const all = Array.from(
      plate.querySelectorAll<HTMLDetailsElement>(".exprow details"),
    );
    if (all.length === 0) return;
    // A double-click on bullet text selects a word; do not toggle for it.
    clearTimeout(pending);
    if (e.detail > 1) return;
    if (window.getSelection()?.toString()) return;
    if (t.closest(".exprow details > ul")) {
      pending = setTimeout(() => toggleAll(all), 300);
    } else {
      toggleAll(all);
    }
  });
  let pending: ReturnType<typeof setTimeout> | undefined;
  function toggleAll(all: HTMLDetailsElement[]) {
    if (window.getSelection()?.toString()) return;
    const open = all.some((d) => !d.open);
    all.forEach((d) => {
      if (reduce.matches) {
        d.open = open;
      } else if (open) {
        if (!d.open) {
          d.open = true;
          run(d, true);
        }
      } else if (d.open) {
        run(d, false);
      }
    });
  }

  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          en.target.classList.add("in");
          io.unobserve(en.target);
        });
      },
      { threshold: 0.1 },
    );
    document
      .querySelectorAll(".right .sec:not(:first-child) :is(.plate, .hd)")
      .forEach((el) => io.observe(el));
  } else {
    document
      .querySelectorAll(".right .sec:not(:first-child) :is(.plate, .hd)")
      .forEach((el) => el.classList.add("in"));
  }
</script>
