---
import TeamLayout from "../layouts/TeamLayout.astro";
import Header from "../components/team/Header.astro";
import Hero from "../components/team/Hero.astro";
import Now from "../components/team/Now.astro";
import Work from "../components/team/Work.astro";
import Services from "../components/team/Services.astro";
import Promises from "../components/team/Promises.astro";
import Team from "../components/team/Team.astro";
import Faq from "../components/team/Faq.astro";
import Contact from "../components/team/Contact.astro";
import Footer from "../components/team/Footer.astro";
import StickyCta from "../components/team/StickyCta.astro";
---

<TeamLayout
  title="JAG · Websites and apps, built by the three of us"
  description="JAG is a three-person studio in Irvine, California. We build websites and iOS and Android apps for companies, and you talk directly to the engineers who write the code."
>
  <Header />
  <main id="main">
    <Hero />
    <Now />
    <Work />
    <Services />
    <Promises />
    <Team />
    <Faq />
    <Contact />
  </main>
  <Footer />
  <StickyCta />
</TeamLayout>
